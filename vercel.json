{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd frontend && yarn install --frozen-lockfile",
  "buildCommand": "cd frontend && yarn install --frozen-lockfile && yarn prisma generate && yarn build",
  "outputDirectory": "frontend/.next",
  "devCommand": "cd frontend && yarn dev",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- frontend/"
}
