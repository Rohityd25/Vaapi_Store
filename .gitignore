# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any level)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
/test_reports/

# next.js (any level)
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (do not commit secrets)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python backend
__pycache__/
*.py[cod]
*.egg-info/
.venv/
/backend/venv/

# Emergent platform / agent memory (do not push)
/memory/
/.emergent/

# supervisor logs (if any got into /app)
/var/
*.env
credentials.json
*.key
.credentials
