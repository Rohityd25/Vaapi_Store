generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  STAFF
  VENDOR
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StockMovementType {
  RESTOCK
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  emailVerified DateTime?
  passwordHash String?
  phone        String?
  image        String?
  role         Role       @default(CUSTOMER)
  isBlocked    Boolean    @default(false)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  addresses Address[]
  orders    Order[]
  wishlist  Wishlist[]
  reviews   Review[]
  accounts  Account[]
  sessions  Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Vendor ──────────────────────────────────────────────────────────────────

model Vendor {
  id            String  @id @default(cuid())
  name          String
  contactEmail  String
  contactPhone  String
  gstNumber     String?
  bankDetails   Json?
  commissionPct Float   @default(0)
  isActive      Boolean @default(true)

  users    User[]
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  parentId    String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id             String  @id @default(cuid())
  title          String
  slug           String  @unique
  description    String
  brand          String?
  basePrice      Float
  compareAtPrice Float?
  isActive       Boolean @default(true)
  isBestseller   Boolean @default(false)
  isNewArrival   Boolean @default(false)
  seoTitle       String?
  seoDescription String?
  tags           String[] @default([])

  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([isBestseller])
  @@index([isNewArrival])
  @@index([categoryId])
  @@index([vendorId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  position  Int     @default(0)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String  @id @default(cuid())
  sku           String  @unique
  size          String
  color         String
  colorHex      String? // for color swatch rendering
  price         Float
  stock         Int     @default(0)
  lowStockAlert Int     @default(5)
  isActive      Boolean @default(true)
  productId     String

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@index([productId])
  @@index([sku])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model StockMovement {
  id        String            @id @default(cuid())
  type      StockMovementType
  quantity  Int
  note      String?
  createdBy String?           // userId of staff member who made the change
  variantId String

  variant ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())

  @@index([variantId])
}

// ─── Addresses ───────────────────────────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id        String  @id @default(cuid())
  userId    String? @unique
  sessionId String? @unique

  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  quantity  Int
  cartId    String
  variantId String

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([cartId])
}

// ─── Coupons ─────────────────────────────────────────────────────────────────

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String    // "PERCENT" | "FLAT"
  value         Float
  minOrderValue Float?
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  description   String?

  createdAt DateTime @default(now())

  @@index([code])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique @default(cuid()) // human-readable
  guestEmail        String?
  address           Json          // snapshot of address at time of order
  subtotal          Float
  discount          Float         @default(0)
  shippingFee       Float         @default(0)
  total             Float
  couponCode        String?
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            OrderStatus   @default(PENDING)
  shiprocketOrderId String?
  trackingUrl       String?
  notes             String?
  userId            String?

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  price     Float  // price at time of order
  orderId   String
  variantId String

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String  @id @default(cuid())
  rating    Int     // 1-5
  comment   String?
  isApproved Boolean @default(false)
  productId String
  userId    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────

model Wishlist {
  id        String @id @default(cuid())
  productId String
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Content / CMS ───────────────────────────────────────────────────────────

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  mobileImageUrl String?
  linkUrl   String?
  ctaText   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  coverImage     String
  body           String    // rich text / markdown
  author         String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([publishedAt])
}
